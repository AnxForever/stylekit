# Copy this file to .env.local and fill your own values.
# Never commit .env.local or real keys to git.

# WisArt OpenAI-compatible image API (server-side only)
WISART_API_KEY=
WISART_BASE_URL=https://wisart.kuaileshifu.com
WISART_OPENAI_BASE_URL=https://wisart.kuaileshifu.com/v1
WISART_IMAGE_MODEL=gpt-image-2
WISART_IMAGE_RESPONSE_FORMAT=b64_json

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Optional: set to "true" to bypass login with a mock user in development
NEXT_PUBLIC_DEV_MOCK_USER=

# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (server-only, do NOT add NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated user IDs allowed for admin routes
ADMIN_USER_IDS=
# Optional: bearer token for admin API access
ADMIN_API_TOKEN=
# Optional: password login for a standalone admin deployment
ADMIN_PASSWORD=
# Optional: SHA-256 hex digest alternative to ADMIN_PASSWORD
ADMIN_PASSWORD_SHA256=
# Optional: long random secret used to sign admin password sessions
ADMIN_SESSION_SECRET=
# Optional: admin password session lifetime in seconds (default 43200)
ADMIN_SESSION_MAX_AGE_SECONDS=43200
# Optional: max rows per admin audit CSV export (default 5000)
ADMIN_AUDIT_EXPORT_MAX_ROWS=5000
# Keep empty until a real, auditable checkout or deposit flow is implemented.
PACK_CHECKOUT_PROVIDER=
# Optional: retention window in days for admin audit logs (default 30)
ADMIN_AUDIT_RETENTION_DAYS=30
# Optional: additional trusted origins for CSRF checks (comma-separated)
CSRF_TRUSTED_ORIGINS=

# Email login OTP. AUTH_SMTP_* overrides the feedback SMTP settings below;
# when omitted, email login reuses FEEDBACK_SMTP_*.
EMAIL_OTP_SECRET=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM=

# Linux DO Connect OAuth (apply at https://connect.linux.do/dash/sso)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# Optional: override Linux DO base URL for server-to-server calls (token + user
# info). Use this when the host network cannot reach connect.linux.do directly,
# e.g. point to a Cloudflare Worker that proxies the official endpoint.
# Default: https://connect.linux.do
LINUXDO_BASE_URL=

# NodeLoc OAuth Provider (apply at https://www.nodeloc.com/oauth-provider/applications)
NODELOC_CLIENT_ID=
NODELOC_CLIENT_SECRET=
# Optional: override the NodeLoc API host. Default: https://www.nodeloc.com
NODELOC_BASE_URL=

# Sentry error monitoring (get DSN from https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# SEO: Search engine verification codes
# Google: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# Feedback form SMTP (changelog "send feedback" form → your inbox).
# Server-only; never commit real values. The pass is the mailbox SMTP
# "authorization code" (not the login password) from your email settings.
# QQ:  FEEDBACK_SMTP_HOST=smtp.qq.com   FEEDBACK_SMTP_PORT=465
# 163: FEEDBACK_SMTP_HOST=smtp.163.com  FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_TO=

# Bailian / DashScope Style Advisor (server-side only)
# Use replay mode when this is empty; never expose the key through NEXT_PUBLIC_.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
STYLE_ADVISOR_PROVIDER=dashscope
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
