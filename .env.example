# Copy this file to .env.local and fill your own values.
# Never commit .env.local or real keys to git.

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Optional: set to "true" to bypass login with a mock user in development
NEXT_PUBLIC_DEV_MOCK_USER=

# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (server-only, do NOT add NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated user IDs allowed for admin routes
ADMIN_USER_IDS=
# Optional: bearer token for admin API access
ADMIN_API_TOKEN=
# Optional: password login for a standalone admin deployment
ADMIN_PASSWORD=
# Optional: SHA-256 hex digest alternative to ADMIN_PASSWORD
ADMIN_PASSWORD_SHA256=
# Optional: long random secret used to sign admin password sessions
ADMIN_SESSION_SECRET=
# Optional: admin password session lifetime in seconds (default 43200)
ADMIN_SESSION_MAX_AGE_SECONDS=43200
# Optional: max rows per admin audit CSV export (default 5000)
ADMIN_AUDIT_EXPORT_MAX_ROWS=5000
# Optional: retention window in days for admin audit logs (default 30)
ADMIN_AUDIT_RETENTION_DAYS=30
# Optional: additional trusted origins for CSRF checks (comma-separated)
CSRF_TRUSTED_ORIGINS=

# Linux DO Connect OAuth (apply at https://connect.linux.do/dash/sso)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# Optional: override Linux DO base URL for server-to-server calls (token + user
# info). Use this when the host network cannot reach connect.linux.do directly,
# e.g. point to a Cloudflare Worker that proxies the official endpoint.
# Default: https://connect.linux.do
LINUXDO_BASE_URL=

# Sentry error monitoring (get DSN from https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# SEO: Search engine verification codes
# Google: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=
