{
  "name": "stylekit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:style-rules": "npx --no-install tsx tools/scripts/lint-style-rules.ts",
    "typecheck": "rm -rf .next/dev .next/types && npx --no-install tsc --noEmit",
    "security:secrets": "node tools/scripts/check-secrets.cjs",
    "check:catalog": "npx --no-install tsx tools/scripts/check-catalog-integrity.ts",
    "check:support-assets": "npx --no-install tsx tools/scripts/check-support-assets.ts",
    "check:product-truth": "npx --no-install tsx tools/scripts/check-product-truth.ts",
    "check:experience-packs": "npx --no-install tsx tools/scripts/check-experience-packs.ts",
    "check:product-validation-readiness": "npx --no-install tsx tools/scripts/check-product-validation-readiness.ts",
    "analytics:migrate": "bash tools/scripts/apply-admin-analytics-migration.sh",
    "analytics:verify-production": "node tools/scripts/verify-admin-analytics-production.mjs",
    "test:pack-install": "node tools/scripts/verify-pack-install.mjs",
    "test:workspace-generation": "npx --no-install tsx tools/scripts/verify-workspace-generation.ts",
    "check:seo-truth": "npx --no-install tsx tools/scripts/check-seo-truth.ts",
    "check:seo-runtime": "node tools/scripts/check-seo-runtime.mjs",
    "validate:product-experiment": "npx --no-install tsx tools/scripts/evaluate-product-validation.ts",
    "check:component-preview": "node tools/scripts/check-component-preview.cjs",
    "check:style-extractor": "node tools/scripts/check-style-extractor.cjs",
    "smoke": "node tools/scripts/smoke-check.mjs",
    "smoke:local": "node tools/scripts/smoke-next-start.mjs",
    "submission:validate": "npx --no-install tsx tools/submission/validate-manifest.ts",
    "test": "npx --no-install vitest run --config tests/vitest.config.ts",
    "test:run": "npx --no-install vitest run --config tests/vitest.config.ts",
    "test:coverage": "npx --no-install vitest run --config tests/vitest.config.ts --coverage",
    "test:style-extractor": "if [ -f tests/unit/style-extractor-registry.test.ts ]; then npx --no-install vitest run --config tests/vitest.config.ts tests/unit/style-extractor-registry.test.ts; else echo 'No style extractor registry test found; skipping.'; fi",
    "test:style-extractor:ci": "pnpm run check:style-extractor && pnpm run test:style-extractor",
    "test:preview-visual": "npx --no-install playwright test --config tests/playwright.config.ts tests/e2e/approved-preview-visual.spec.ts",
    "e2e": "npx playwright test --config tests/playwright.config.ts",
    "e2e:ui": "npx playwright test --config tests/playwright.config.ts --ui",
    "images:optimize": "node tools/scripts/optimize-images.mjs",
    "audit:style-images": "node tools/scripts/audit-style-images.mjs",
    "capture:corporate-clean-evidence": "node tools/scripts/capture-corporate-clean-evidence.mjs",
    "readme:star-history": "node tools/scripts/generate-star-history.mjs",
    "images:generate": "node tools/scripts/generate-style-images.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^1.6.1",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@sentry/nextjs": "^10.43.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.6.1",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
