{
  "compilerOptions": {
    "types": ["vitest/globals"],
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "stylekit-core": ["./packages/core/src/index.ts"],
      "stylekit-core/discovery": ["./packages/core/src/discovery/index.ts"],
      "stylekit-core/export": ["./packages/core/src/export/index.ts"],
      "stylekit-core/prompt": ["./packages/core/src/prompt/index.ts"],
      "stylekit-core/styles": ["./packages/core/src/styles/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "style-extractor-dev/templates/**/*", "packages/core", "tests/e2e", "tests/playwright.config.ts", "tools/scripts", "tools/remotion-assets", "editorial-brutalist-portfolio", "dashboards", "services"]
}
