{
  "name": "stylekit-mcp",
  "version": "0.5.0",
  "mcpName": "io.github.AnxForever/stylekit-mcp",
  "description": "MCP server for StyleKit design styles, tokens, recipes, assets, lint and repair. Remote HTTP or local stdio; works with Claude, ChatGPT, Claude Code, Codex CLI, Gemini CLI, VS Code, and Cursor.",
  "type": "module",
  "bin": {
    "stylekit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "clean": "node ../../tools/scripts/clean-generated.mjs mcp",
    "start:http": "node dist/index.js --http",
    "test": "node scripts/smoke.mjs && tsx scripts/live-lint.test.ts && node scripts/http-smoke.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20",
    "stylekit-core": "workspace:*",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "stylekit",
    "design-system",
    "design-tokens",
    "shadcn",
    "tailwind",
    "tailwindcss",
    "ui-design",
    "web-design",
    "frontend",
    "ai",
    "llm",
    "ai-prompts",
    "cursor",
    "claude",
    "claude-code",
    "chatgpt",
    "codex",
    "codex-cli",
    "gemini-cli",
    "copilot",
    "vscode",
    "zed",
    "cline",
    "windsurf",
    "remote-mcp",
    "streamable-http",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "AnxForever",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnxForever/stylekit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/AnxForever/stylekit/tree/main/packages/mcp#readme"
}
