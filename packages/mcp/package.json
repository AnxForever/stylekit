{
  "name": "stylekit-mcp",
  "version": "0.2.4",
  "mcpName": "io.github.AnxForever/stylekit-mcp",
  "description": "MCP server for StyleKit — search 148 design styles and pull tokens, recipes, and shadcn install commands from Claude, Cursor, or Windsurf",
  "type": "module",
  "bin": {
    "stylekit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "stylekit-core": "workspace:*",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "stylekit",
    "design-system",
    "design-tokens",
    "shadcn",
    "tailwind",
    "tailwindcss",
    "ui-design",
    "web-design",
    "frontend",
    "ai",
    "llm",
    "ai-prompts",
    "cursor",
    "claude",
    "chatgpt",
    "copilot",
    "windsurf",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "AnxForever",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnxForever/stylekit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/AnxForever/stylekit/tree/main/packages/mcp#readme"
}
