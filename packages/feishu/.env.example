# Feishu app credentials. Get them by running:
#   pnpm --filter stylekit-feishu register
# (prints a QR link — scan it, credentials land in the terminal)
# or create a self-built app at open.feishu.cn and copy them manually.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# LLM endpoint (OpenAI-compatible chat/completions).
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=
LLM_API_KEY=

# Optional: only respond in these group chats (comma-separated oc_... ids).
# FEISHU_ALLOWED_GROUPS=

# Optional: lark-cli binary location if it is not on PATH.
# LARK_CLI_BIN=lark-cli
