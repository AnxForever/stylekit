{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../lib/accessibility/**/*.ts",
    "../../lib/recipes/**/*.ts",
    "../../lib/styles/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
