{
  "name": "@stylekit/core",
  "version": "1.0.0-beta.1",
  "description": "StyleKit core library - design style tokens, recipes, linter, and knowledge base for 88+ UI styles",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js",
      "require": "./dist/styles/index.cjs"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js",
      "require": "./dist/recipes/index.cjs"
    },
    "./linter": {
      "types": "./dist/linter/index.d.ts",
      "import": "./dist/linter/index.js",
      "require": "./dist/linter/index.cjs"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js",
      "require": "./dist/knowledge/index.cjs"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "import": "./dist/accessibility/index.js",
      "require": "./dist/accessibility/index.cjs"
    },
    "./quality": {
      "types": "./dist/quality/index.d.ts",
      "import": "./dist/quality/index.js",
      "require": "./dist/quality/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "design-system",
    "style-tokens",
    "css",
    "tailwind",
    "react",
    "ui-styles",
    "linter",
    "accessibility",
    "wcag",
    "design-tokens",
    "recipes",
    "ai"
  ],
  "license": "MIT",
  "author": "AnxForever",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnxForever/stylekit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AnxForever/stylekit/issues"
  },
  "homepage": "https://github.com/AnxForever/stylekit/tree/main/packages/core#readme",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
